# =============================================================================
# Haia — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. This file (.env.example) IS committed.
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE
# Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key          # Safe to expose to Next.js client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Backend only — never in client bundle


# -----------------------------------------------------------------------------
# GEMINI API
# aistudio.google.com → Get API Key
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key


# -----------------------------------------------------------------------------
# TELEGRAM BOT
# Message @BotFather → /newbot
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret   # Any long random string you generate


# -----------------------------------------------------------------------------
# GOOGLE OAUTH (Calendar API + Gmail SMTP)
# console.cloud.google.com → new project → enable Calendar API + Gmail API
# → OAuth consent screen → Create OAuth 2.0 Client ID (Web application)
# Authorized redirect URI: http://localhost:8000/api/v1/integrations/google/callback
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback


# -----------------------------------------------------------------------------
# EMAIL (Mailgun OR Postmark — pick one)
#
# Mailgun: mailgun.com → Sending → Domains → Add domain
#          (use a subdomain like parse.yourdomain.com for inbound routes)
# Postmark: postmarkapp.com → Inbound → set webhook URL
# -----------------------------------------------------------------------------
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=parse.yourdomain.com
MAILGUN_WEBHOOK_SIGNING_KEY=your-mailgun-webhook-signing-key

# Leave blank if using Mailgun
POSTMARK_SERVER_TOKEN=


# -----------------------------------------------------------------------------
# SENTRY (optional — error monitoring)
# sentry.io → Projects → create two (FastAPI + Next.js)
# -----------------------------------------------------------------------------
SENTRY_DSN_API=
SENTRY_DSN_WEB=


# -----------------------------------------------------------------------------
# APP CONFIG
# -----------------------------------------------------------------------------
APP_ENV=development                    # development | staging | production
API_BASE_URL=http://localhost:8000     # Public URL of the FastAPI backend
WEB_BASE_URL=http://localhost:3000     # Public URL of the Next.js frontend
CORS_ORIGINS=http://localhost:3000     # Comma-separated list of allowed origins

# Secret used to sign internal tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your-long-random-secret-key

# =============================================================================
# Haia — .gitignore
# =============================================================================

# Environment variables — NEVER commit real secrets
.env
.env.local
.env.*.local
api/.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
dist/
build/
.pytest_cache/

# Node / Next.js
node_modules/
web/.next/
web/out/
web/build/

# Generated schedule PNGs (Playwright renderer output)
*.schedule.png
/tmp/haia-*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*

# Python Linters, Formatters & Test Coverage
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Secrets & API Credentials
*.pem
*.key
credentials.json
client_secret.json
google-credentials.json

# Next.js & Node.js Caches / Deployment
web/.eslintcache
web/.turbo/
web/.vercel/

# Database Files
*.sqlite3
*.db

# JS/E2E Testing Artifacts
web/coverage/
web/playwright-report/
web/test-results/

# AI Context Documents
CONTEXT.md
agents.md
AGENTS.md
token.json
.agents/